.DS_Store
.build/
DerivedData/
xcuserdata/
*.xcresult
.swiftpm/
# xcodebuild run from apple/AppleApps or apple/ConduitKit drops a `build/`
# beside the project, unlike SwiftPM's dotted `.build/`. Untracked and easy to
# commit by accident.
apple/*/build/

# Go
core/conduitd
core/conformance
*.test

# Android / Kotlin
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/.idea/
*.jar
# ...except the Gradle wrapper jar, which MUST be committed: without it
# `./gradlew` cannot bootstrap, and a repo with no wrapper is a repo nobody
# else can build. (Verified against the published SHA-256 for Gradle 8.9.)
!android/gradle/wrapper/gradle-wrapper.jar

# Private strategy notes live outside the repo (MOSIS/marketing-notes/)
marketing/
